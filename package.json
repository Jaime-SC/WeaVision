{
  "name": "weavision",
  "version": "2.2.0",
  "private": true,
  "description": "WeaVision: reproductor IPTV para Windows, Android, Android TV y Android Auto",
  "author": "Jaime Arturo Sánchez Cerda",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "animejs": "^4.5.0",
    "hls.js": "^1.7.4",
    "motion": "^14.14.0",
    "mpegts.js": "^1.8.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "1.63.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "cl.loscarewea.weavision",
    "productName": "WeaVision",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "WeaVision-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WeaVision",
      "artifactName": "WeaVision-windows-setup.${ext}"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg-LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg-README.txt"
      }
    ]
  }
}
